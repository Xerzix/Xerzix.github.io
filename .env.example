# Lumina server configuration. Copy to `.env` (never commit it) or set real environment
# variables. Everything is optional in development; production needs SESSION_SECRET.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development            # production enables Secure cookies, HSTS and required secrets
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080 # used in email links and the Origin check
TRUST_PROXY=false               # true behind a reverse proxy/CDN that sets X-Forwarded-For
SESSION_SECRET=                 # REQUIRED in production: 32+ random bytes (e.g. `openssl rand -hex 32`)
SECURE_COOKIES=                 # defaults to true in production
SESSION_TTL_DAYS=30
ELEVATED_MINUTES=15             # how long a staff re-authentication lasts

# ── Storage ───────────────────────────────────────────────
DATA_DIR=var                    # database + private storage live here (gitignored)
# DATABASE_PATH=var/lumina.db
# STORAGE_DIR=var/storage

# ── Accounts & security ───────────────────────────────────
ALLOW_REGISTRATION=true
MAX_PROFILES=5
MAX_FAILED_LOGINS=8
LOCK_MINUTES=15
ADMIN_REQUIRE_2FA=false         # true requires TOTP for moderators/admins

# ── Email (password reset, security notices) ──────────────
MAIL_TRANSPORT=log              # log (development) | webhook (production relay/provider)
MAIL_WEBHOOK_URL=               # receives POST {from, to, subject, text}
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=Lumina <no-reply@example.com>

# ── Media & streaming ─────────────────────────────────────
FFMPEG_PATH=                    # enables the transcoding worker (HLS ladders)
FFPROBE_PATH=                   # detailed media probing of uploads
TRANSCODE_IN_PROCESS=true       # false: run `npm run worker` as a separate process
MEDIA_URL_MINUTES=240           # lifetime of signed private-media URLs
# Extra origins the player may load manifests/segments/artwork from (CSP allowlist)
MEDIA_ORIGINS=https://test-streams.mux.dev,https://demo.unified-streaming.com,https://bitdash-a.akamaihd.net,https://devstreaming-cdn.apple.com,https://commondatastorage.googleapis.com
REQUIRE_SIGNIN_TO_PLAY=false

# ── Uploads ───────────────────────────────────────────────
UPLOAD_MAX_BYTES=53687091200    # 50 GiB per video file
UPLOAD_MAX_IMAGE_BYTES=15728640
UPLOAD_MAX_DOCUMENT_BYTES=26214400
UPLOAD_CHUNK_MAX_BYTES=67108864
UPLOAD_EXPIRE_HOURS=72
UPLOAD_SCAN_COMMAND=            # e.g. "clamdscan --no-summary" (exit 0 clean, 1 infected)

# ── Velvia Suggestions ────────────────────────────────────
VELVIA_PROVIDER=local           # local (built-in catalog engine) | anthropic | openai-compatible
VELVIA_API_KEY=                 # provider key (server-side only)
VELVIA_MODEL=                   # anthropic default: claude-opus-5-5
VELVIA_BASE_URL=                # openai-compatible: e.g. http://localhost:11434/v1
VELVIA_TIMEOUT_MS=20000

# ── Metadata import (admin only) ──────────────────────────
TMDB_API_TOKEN=                 # TMDB v4 read token; metadata only, never sent to browsers

# ── Features & monetization ───────────────────────────────
FEATURE_REVIEW_COMMENTS=true
FEATURE_WATCH_PARTIES=true
FEATURE_SHARED_COLLECTIONS=true
MONETIZATION_MODE=free          # only "free" is implemented; see docs/MONETIZATION.md

LOG_LEVEL=info
